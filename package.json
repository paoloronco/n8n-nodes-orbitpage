{
  "name": "n8n-nodes-orbitpage",
  "version": "0.3.2",
  "description": "Official OrbitPage community nodes for n8n website content, publishing, media, analytics, AI, Shop, domains, backups, and workflow triggers",
  "license": "MIT",
  "homepage": "https://orbitpage.com/en-US/docs/api-tokens#integration",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "n8n-nodes",
    "n8n-community-node",
    "orbitpage",
    "automation",
    "workflow",
    "workflow-automation",
    "website-automation",
    "website-builder",
    "link-in-bio",
    "personal-website",
    "content-management",
    "publishing",
    "api-integration"
  ],
  "author": {
    "name": "Paolo Ronco",
    "email": "contact@orbitpage.com",
    "url": "https://orbitpage.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paoloronco/n8n-nodes-orbitpage.git"
  },
  "bugs": {
    "url": "https://github.com/paoloronco/n8n-nodes-orbitpage/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:watch": "tsc --watch",
    "dev": "node scripts/dev.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run test",
    "audit:runtime": "npm audit --omit=dev",
    "docs:generate": "node scripts/generate-operation-docs.cjs",
    "docs:check": "node scripts/generate-operation-docs.cjs --check && node scripts/check-markdown-links.cjs",
    "check": "npm run lint && npm run build && npm run load:check && npm run docs:check && npm run test",
    "load:check": "node scripts/check-package-load.cjs",
    "release": "node scripts/release.cjs",
    "prepublishOnly": "node scripts/check-publish.cjs"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/OrbitPageApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OrbitPage/OrbitPage.node.js",
      "dist/nodes/OrbitPageTrigger/OrbitPageTrigger.node.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@n8n/eslint-plugin-community-nodes": "0.35.1",
    "@types/node": "22.20.5",
    "eslint": "9.29.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n8n-nodes-base": "1.16.7",
    "n8n-workflow": "2.43.5",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
