{
  "name": "n8n-nodes-orbitpage",
  "version": "0.2.1",
  "description": "Official OrbitPage community nodes for n8n website content, publishing, media, analytics, AI, Shop, domains, backups, and workflow triggers",
  "license": "MIT",
  "homepage": "https://orbitpage.com/en-US/docs/api-tokens#integration",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "n8n-nodes",
    "n8n-community-node",
    "orbitpage",
    "automation",
    "workflow",
    "workflow-automation",
    "website-automation",
    "website-builder",
    "link-in-bio",
    "personal-website",
    "content-management",
    "publishing",
    "api-integration"
  ],
  "author": {
    "name": "Paolo Ronco",
    "email": "contact@orbitpage.com",
    "url": "https://orbitpage.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paoloronco/n8n-nodes-orbitpage.git"
  },
  "bugs": {
    "url": "https://github.com/paoloronco/n8n-nodes-orbitpage/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest run test",
    "docs:generate": "node scripts/generate-operation-docs.cjs",
    "docs:check": "node scripts/generate-operation-docs.cjs --check && node scripts/check-markdown-links.cjs",
    "check": "npm run lint && npm run build && npm run load:check && npm run docs:check && npm run test",
    "load:check": "node scripts/check-package-load.cjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/OrbitPageApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OrbitPage/OrbitPage.node.js",
      "dist/nodes/OrbitPageTrigger/OrbitPageTrigger.node.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@n8n/node-cli": "0.46.2",
    "eslint": "9.39.4",
    "n8n-workflow": "2.37.2",
    "prettier": "3.8.3",
    "release-it": "21.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
